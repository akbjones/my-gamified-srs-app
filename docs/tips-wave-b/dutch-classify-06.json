 {
  "id": "nl-3183",
  "verdict": "rewrite",
  "category": "nominalized-infinitive",
  "focus": "Drop 'infinitive-as-noun' jargon: Dutch turns a verb into a noun with 'het' – 'het opruimen' = the cleaning-up, so 'beginnen met het opruimen' = start the tidying."
 },
 {
  "id": "nl-3191",
  "verdict": "rewrite",
  "category": "construction",
  "focus": "Surface the literal logic: 'krijgen te horen' = literally 'get to hear' = to be told. Quote 'kregen te horen dat'."
 },
 {
  "id": "nl-3194",
  "verdict": "rewrite",
  "category": "idiom-literal",
  "focus": "Give the literal image: 'hoe de vork in de steel zit' = literally how the fork sits in its handle = how things really stand."
 },
 {
  "id": "nl-3196",
  "verdict": "rewrite",
  "category": "er-construction",
  "focus": "The anticipatory 'er': slagen in → erin slagen. 'Zij slaagt erin om ... te krijgen' = she succeeds in getting it done. Plain words."
 },
