          "similar": ["ड"]
        }
      ]
    },
    {
      "title": "Vowel signs (matras)",
      "items": [
        {
          "kind": "modifier",
          "glyph": "ा",
          "sound": "aa sign",
          "romanization": "aa",
          "mnemonic": "Matras are vowel signs that ride on consonants. One extra post after the letter stretches the built-in a to aa: क → का (kaa)."
