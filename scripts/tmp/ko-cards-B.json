[
  { "id": "ko-0076", "target": "물을 마셔요.", "english": "I drink water.", "audio": "ko-ko-0076.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 76, "grammar": "을/를 marks the object — 을 after a consonant, 를 after a vowel: 물을 마셔요 (mur-eul masyeoyo = I drink water)." },
  { "id": "ko-0077", "target": "커피를 마셔요.", "english": "I drink coffee.", "audio": "ko-ko-0077.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 77 },
  { "id": "ko-0078", "target": "밥을 먹어요.", "english": "I eat rice.", "audio": "ko-ko-0078.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 78 },
  { "id": "ko-0079", "target": "빵을 먹어요.", "english": "I eat bread.", "audio": "ko-ko-0079.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 79 },
  { "id": "ko-0080", "target": "책을 읽어요.", "english": "I read a book.", "audio": "ko-ko-0080.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 80 },
  { "id": "ko-0081", "target": "사과를 사요.", "english": "I buy apples.", "audio": "ko-ko-0081.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 81, "grammar": "사요 means 'buy' — one letter from 싸요 (ssayo = cheap): 사과를 사요 (sagwa-reul sayo = I buy apples)." },
  { "id": "ko-0082", "target": "영화를 봐요.", "english": "I watch a movie.", "audio": "ko-ko-0082.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 82 },
  { "id": "ko-0083", "target": "우유를 마셔요.", "english": "I drink milk.", "audio": "ko-ko-0083.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 83 },
  { "id": "ko-0084", "target": "김치를 좋아해요.", "english": "I like kimchi.", "audio": "ko-ko-0084.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 84, "grammar": "좋아해요 'like' takes an object with 을/를: 김치를 좋아해요 (gimchi-reul joahaeyo = I like kimchi)." },
  { "id": "ko-0085", "target": "친구를 만나요.", "english": "I meet a friend.", "audio": "ko-ko-0085.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 85 },
  { "id": "ko-0086", "target": "신문을 읽어요.", "english": "I read the newspaper.", "audio": "ko-ko-0086.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 86 },
  { "id": "ko-0087", "target": "차를 마셔요.", "english": "I drink tea.", "audio": "ko-ko-0087.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 87 },
  { "id": "ko-0088", "target": "텔레비전을 봐요.", "english": "I watch television.", "audio": "ko-ko-0088.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 88 },
  { "id": "ko-0089", "target": "과일을 사요.", "english": "I buy fruit.", "audio": "ko-ko-0089.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 89 },
  { "id": "ko-0090", "target": "음악을 들어요.", "english": "I listen to music.", "audio": "ko-ko-0090.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 90, "grammar": "들어요 covers both 'listen' and 'hear': 음악을 들어요 (eumag-eul deureoyo = I listen to music)." },
  { "id": "ko-0091", "target": "저는 커피를 좋아해요.", "english": "I like coffee.", "audio": "ko-ko-0091.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 91, "grammar": "은/는 sets the topic — 'as for X': 저는 커피를 좋아해요 (jeo-neun keopi-reul joahaeyo)." },
  { "id": "ko-0092", "target": "동생은 우유를 마셔요.", "english": "My younger sibling drinks milk.", "audio": "ko-ko-0092.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 92 },
  { "id": "ko-0093", "target": "친구가 와요.", "english": "A friend is coming.", "audio": "ko-ko-0093.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 93, "grammar": "이/가 marks the subject — 가 after a vowel, 이 after a consonant: 친구가 와요 (chingu-ga wayo)." },
  { "id": "ko-0094", "target": "버스가 와요.", "english": "The bus is coming.", "audio": "ko-ko-0094.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 94 },
  { "id": "ko-0095", "target": "시간이 없어요.", "english": "I don't have time.", "audio": "ko-ko-0095.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 95 },
  { "id": "ko-0096", "target": "돈이 없어요.", "english": "I don't have money.", "audio": "ko-ko-0096.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 96 },
  { "id": "ko-0097", "target": "물이 있어요.", "english": "There is water.", "audio": "ko-ko-0097.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 97 },
  { "id": "ko-0098", "target": "학교에 가요.", "english": "I go to school.", "audio": "ko-ko-0098.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 98, "grammar": "에 marks a destination or a time: 학교에 가요 (hakgyo-e gayo = I go to school)." },
  { "id": "ko-0099", "target": "시장에 가요.", "english": "I go to the market.", "audio": "ko-ko-0099.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 99 },
  { "id": "ko-0100", "target": "집에 있어요.", "english": "I'm at home.", "audio": "ko-ko-0100.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 100 },
  { "id": "ko-0101", "target": "카페에서 커피를 마셔요.", "english": "I drink coffee at a cafe.", "audio": "ko-ko-0101.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 101, "grammar": "에서 marks where an action happens: 카페에서 마셔요 (kape-eseo masyeoyo = I drink at a cafe)." },
  { "id": "ko-0102", "target": "집에서 요리해요.", "english": "I cook at home.", "audio": "ko-ko-0102.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 102 },
  { "id": "ko-0103", "target": "도서관에서 공부해요.", "english": "I study at the library.", "audio": "ko-ko-0103.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 103 },
  { "id": "ko-0104", "target": "회사에서 일해요.", "english": "I work at a company.", "audio": "ko-ko-0104.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 104 },
  { "id": "ko-0105", "target": "식당에서 밥을 먹어요.", "english": "I eat at a restaurant.", "audio": "ko-ko-0105.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 105 },
  { "id": "ko-0106", "target": "저도 커피를 마셔요.", "english": "I drink coffee too.", "audio": "ko-ko-0106.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 106, "grammar": "도 means 'too' and replaces 은/는 or 을/를: 저도 마셔요 (jeo-do masyeoyo = I drink too)." },
  { "id": "ko-0107", "target": "동생도 학교에 가요.", "english": "My younger sibling goes to school too.", "audio": "ko-ko-0107.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 107 },
  { "id": "ko-0108", "target": "빵도 사요.", "english": "I buy bread too.", "audio": "ko-ko-0108.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 108 },
  { "id": "ko-0109", "target": "오늘도 일해요.", "english": "I work today too.", "audio": "ko-ko-0109.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 109 },
  { "id": "ko-0110", "target": "고기를 안 먹어요.", "english": "I don't eat meat.", "audio": "ko-ko-0110.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 110, "grammar": "안 goes right before the verb: 안 먹어요 (an meogeoyo = I don't eat)." },
  { "id": "ko-0111", "target": "커피를 안 마셔요.", "english": "I don't drink coffee.", "audio": "ko-ko-0111.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 111 },
  { "id": "ko-0112", "target": "텔레비전을 안 봐요.", "english": "I don't watch television.", "audio": "ko-ko-0112.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 112 },
  { "id": "ko-0113", "target": "오늘은 공부 안 해요.", "english": "I'm not studying today.", "audio": "ko-ko-0113.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 113, "grammar": "With 하다 verbs, 안 slips inside: 공부 안 해요 (gongbu an haeyo = I don't study)." },
  { "id": "ko-0114", "target": "오늘은 못 가요.", "english": "I can't go today.", "audio": "ko-ko-0114.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 114, "grammar": "못 = can't, 안 = don't: 못 가요 (mot gayo = I can't go)." },
  { "id": "ko-0115", "target": "생선을 못 먹어요.", "english": "I can't eat fish.", "audio": "ko-ko-0115.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 115 },
  { "id": "ko-0116", "target": "아침에 운동해요.", "english": "I exercise in the morning.", "audio": "ko-ko-0116.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 116 },
  { "id": "ko-0117", "target": "공원에서 산책해요.", "english": "I take a walk in the park.", "audio": "ko-ko-0117.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 117 },
  { "id": "ko-0118", "target": "주스를 마셔요.", "english": "I drink juice.", "audio": "ko-ko-0118.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 118 },
  { "id": "ko-0119", "target": "라면을 먹어요.", "english": "I eat ramyeon.", "audio": "ko-ko-0119.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 119, "grammar": "라면을 먹어요 (ramyeon-eul meogeoyo) — 라면 is instant noodles, Korea's favorite late-night meal." },
  { "id": "ko-0120", "target": "케이크를 만들어요.", "english": "I make a cake.", "audio": "ko-ko-0120.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 120 },
  { "id": "ko-0121", "target": "가방을 사요.", "english": "I buy a bag.", "audio": "ko-ko-0121.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 121 },
  { "id": "ko-0122", "target": "우산을 찾아요.", "english": "I'm looking for my umbrella.", "audio": "ko-ko-0122.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 122, "grammar": "찾아요 means both 'look for' and 'find': 우산을 찾아요 (usan-eul chajayo = I look for my umbrella)." },
  { "id": "ko-0123", "target": "옷을 입어요.", "english": "I put on clothes.", "audio": "ko-ko-0123.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 123 },
  { "id": "ko-0124", "target": "신발을 사요.", "english": "I buy shoes.", "audio": "ko-ko-0124.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 124 },
  { "id": "ko-0125", "target": "문을 열어요.", "english": "I open the door.", "audio": "ko-ko-0125.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 125 },
  { "id": "ko-0126", "target": "창문을 닫아요.", "english": "I close the window.", "audio": "ko-ko-0126.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 126 },
  { "id": "ko-0127", "target": "손을 씻어요.", "english": "I wash my hands.", "audio": "ko-ko-0127.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 127, "grammar": "씻어요 'wash' works for hands, face, and fruit: 손을 씻어요 (son-eul ssiseoyo = I wash my hands)." },
  { "id": "ko-0128", "target": "사진을 봐요.", "english": "I look at photos.", "audio": "ko-ko-0128.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 128 },
  { "id": "ko-0129", "target": "한국어를 배워요.", "english": "I learn Korean.", "audio": "ko-ko-0129.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 129 },
  { "id": "ko-0130", "target": "편지를 써요.", "english": "I write a letter.", "audio": "ko-ko-0130.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 130 },
  { "id": "ko-0131", "target": "이름을 써요.", "english": "I write my name.", "audio": "ko-ko-0131.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 131 },
  { "id": "ko-0132", "target": "버스를 타요.", "english": "I take the bus.", "audio": "ko-ko-0132.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 132, "grammar": "타요 'take/ride' uses 을/를: 버스를 타요 (beoseu-reul tayo = I take the bus)." },
  { "id": "ko-0133", "target": "지하철을 타요.", "english": "I take the subway.", "audio": "ko-ko-0133.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 133 },
  { "id": "ko-0134", "target": "표를 사요.", "english": "I buy a ticket.", "audio": "ko-ko-0134.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 134 },
  { "id": "ko-0135", "target": "마트에서 야채를 사요.", "english": "I buy vegetables at the supermarket.", "audio": "ko-ko-0135.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 135 },
  { "id": "ko-0136", "target": "아버지는 신문을 봐요.", "english": "My father reads the newspaper.", "audio": "ko-ko-0136.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 136, "grammar": "봐요 covers watching and casual reading: 신문을 봐요 (sinmun-eul bwayo = I read the paper)." },
  { "id": "ko-0137", "target": "어머니는 요리를 좋아해요.", "english": "My mother likes cooking.", "audio": "ko-ko-0137.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 137 },
  { "id": "ko-0138", "target": "친구는 커피를 안 마셔요.", "english": "My friend doesn't drink coffee.", "audio": "ko-ko-0138.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 138 },
  { "id": "ko-0139", "target": "우유가 있어요?", "english": "Is there milk?", "audio": "ko-ko-0139.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 139 },
  { "id": "ko-0140", "target": "화장실이 어디에 있어요?", "english": "Where is the bathroom?", "audio": "ko-ko-0140.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 140, "grammar": "The survival question: 화장실이 어디에 있어요? (hwajangsil-i eodi-e isseoyo? = where is the bathroom?)" },
  { "id": "ko-0141", "target": "가게에서 뭐를 사요?", "english": "What are you buying at the store?", "audio": "ko-ko-0141.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 141, "grammar": "In speech 을/를 often drops: 뭐를 사요? → 뭐 사요? (mwo sayo? = what are you buying?)" },
  { "id": "ko-0142", "target": "김밥을 좋아해요?", "english": "Do you like gimbap?", "audio": "ko-ko-0142.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 142, "grammar": "김밥 (gimbap) is seaweed rice rolls: 김밥을 좋아해요? (gimbab-eul joahaeyo? = do you like gimbap?)" },
  { "id": "ko-0143", "target": "네, 김밥을 아주 좋아해요.", "english": "Yes, I really like gimbap.", "audio": "ko-ko-0143.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 143 },
  { "id": "ko-0144", "target": "아니요, 생선을 안 좋아해요.", "english": "No, I don't like fish.", "audio": "ko-ko-0144.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 144 },
  { "id": "ko-0145", "target": "맥주를 마셔요?", "english": "Do you drink beer?", "audio": "ko-ko-0145.mp3", "tags": ["general", "travel"], "grammarNode": "node-02", "priority": 145 },
  { "id": "ko-0146", "target": "아니요, 맥주를 못 마셔요.", "english": "No, I can't drink beer.", "audio": "ko-ko-0146.mp3", "tags": ["general"], "grammarNode": "node-02", "priority": 146 },
  { "id": "ko-0147", "target": "회사에서 컴퓨터를 써요.", "english": "I use a computer at work.", "audio": "ko-ko-0147.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 147, "grammar": "써요 means 'write' and also 'use': 컴퓨터를 써요 (keompyuteo-reul sseoyo = I use a computer)." },
  { "id": "ko-0148", "target": "방을 청소해요.", "english": "I clean the room.", "audio": "ko-ko-0148.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 148 },
  { "id": "ko-0149", "target": "커피가 필요해요.", "english": "I need coffee.", "audio": "ko-ko-0149.mp3", "tags": ["general", "work"], "grammarNode": "node-02", "priority": 149, "grammar": "필요해요 'need' takes 이/가, not 을/를: 커피가 필요해요 (keopi-ga piryohaeyo = I need coffee)." },
  { "id": "ko-0150", "target": "주말에 가족을 만나요.", "english": "I meet my family on the weekend.", "audio": "ko-ko-0150.mp3", "tags": ["general", "family"], "grammarNode": "node-02", "priority": 150 }
]
